# Project specific
# 다운로드된 원본 데이터 (용량이 크므로 Git에서 제외)
data/raw/*/
data/raw/**/*.zip
data/extracted/*/
data/extracted/**/*.csv
data/extracted/**/*.xlsx

# 메타데이터는 포함 (작은 JSON 파일)
!data/metadata/
!data/metadata/*.json

# 로그 파일
logs/*.log
logs/**/*.log

# 임시 파일
*.tmp
*.temp
temp/
tmp/

# 환경 변수 파일
.env
.env.local

# 설정 파일 중 민감 정보가 있을 수 있는 파일
config/*_local.yaml
config/*_private.yaml
